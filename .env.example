# ---------------------------------------------------------------------------
# Alibaba MCP — example configuration
# Copy to `.env` and adjust. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Provider mode:
#   mock  - deterministic offline provider (default; safe for CI and demos)
#   live  - Alibaba.ir live provider (currently unavailable: see
#           docs/live-integration-notes.md — the live provider will refuse to
#           start and tell you exactly why, rather than silently falling back)
ALIBABA_PROVIDER=mock

# --- Server (Streamable HTTP transport) -----------------------------------
ALIBABA_MCP_HOST=127.0.0.1
ALIBABA_MCP_PORT=8000
# Path of the MCP endpoint (clients connect to http://host:port/mcp)
ALIBABA_MCP_PATH=/mcp

# --- Logging ---------------------------------------------------------------
# One of: DEBUG, INFO, WARNING, ERROR
ALIBABA_MCP_LOG_LEVEL=INFO

# --- Rate limiting (server-side protection for tool calls) ------------------
# Maximum tool calls allowed per window, per tool (0 disables the limiter)
ALIBABA_MCP_RATE_LIMIT_MAX_CALLS=60
# Window length in seconds
ALIBABA_MCP_RATE_LIMIT_WINDOW_SECONDS=60

# --- Optional bearer-token authorization (Streamable HTTP only) ------------
# When both values are set, requests must carry:
#     Authorization: Bearer <ALIBABA_MCP_API_TOKEN>
# Leave empty for local development. NEVER enable without TLS in production.
ALIBABA_MCP_API_TOKEN=
ALIBABA_MCP_AUTH_ISSUER_URL=https://auth.example.com
# Scopes required from every token
ALIBABA_MCP_REQUIRED_SCOPES=travel:read

# --- Live provider (placeholder — not currently usable) --------------------
# Base URL of the (undocumented) Alibaba.ir web API. See
# docs/live-integration-notes.md before touching these.
ALIBABA_API_BASE_URL=
ALIBABA_API_TIMEOUT_SECONDS=10
